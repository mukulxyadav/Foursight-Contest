# Database connection string for Prisma
# Using SQLite for development. In production, change to a PostgreSQL URL.
DATABASE_URL="file:./dev.db"

# Secret used to authenticate the admin user (/admin)
ADMIN_SECRET="foursight-admin-2026"

# Enable/disable contest routes on the frontend
NEXT_PUBLIC_CONTEST_ENABLED="true"

# The existing Foursight Cloudflare worker backend API 
NEXT_PUBLIC_API_URL="https://foursight-backend.harshiyer.workers.dev/api/v1"
